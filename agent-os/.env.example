# Public Google Cloud configuration
GOOGLE_CLOUD_PROJECT=agent-os-506220
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_CORE_MODEL=gemini-3.6-flash
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Managed platform resources
FIRESTORE_DATABASE=(default)
ARTIFACT_BUCKET=
PUBSUB_WORKFLOW_TOPIC=agent-os-workflow-events
PUBSUB_WORKFLOW_SUBSCRIPTION=agent-os-workflow-worker
MODEL_ARMOR_TEMPLATE_ID=
AGENT_ENGINE_ID=

# Secret Manager resource names - never put secret values here
GOOGLE_OAUTH_CLIENT_SECRET_NAME=agent-os-google-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN_SECRET_NAME=agent-os-google-oauth-refresh-token
GITHUB_TOKEN_SECRET_NAME=agent-os-github-token

# Non-secret integration identifiers
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_ID=primary
GOOGLE_MEET_INTEGRATION_ENABLED=false
GITHUB_TEAM_OWNER=YashVerma06
GITHUB_TEAM_REPO=Agent_OS
GITHUB_DEMO_OWNER=
GITHUB_DEMO_REPO=agent-os-demo-maintenance-portal

# Application URLs
NEXT_PUBLIC_API_BASE_URL=
APP_BASE_URL=http://localhost:3000
OAUTH_CALLBACK_URL=http://localhost:3000/api/integrations/google/callback

# Demo identity - synthetic/test data only
DEMO_TENANT_ID=agent-os-labs
DEMO_CLIENT_ID=northstar-property-management
DEMO_PROJECT_ID=maintenance-request-portal
